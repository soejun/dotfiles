# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Colorscheme (Tokyo Night Storm)
#
# Ported from an i3 colorscheme. i3's `set_from_resource` reads colors from
# Xresources, which sway/Wayland does not use, so the Xresource fallback values
# are inlined here as literals. Palette matches
# config/kitty/themes/tokyonight/tokyonight_storm.conf.

set $color0      #1d202f
set $color1      #f7768e
set $color2      #9ece6a
set $color3      #e0af68
set $color4      #7aa2f7
set $color5      #bb9af7
set $color6      #7dcfff
set $color7      #a9b1d6
set $color8      #414868
set $color9      #ff899d
set $color10     #9fe044
set $color11     #faba4a
set $color12     #8db0ff
set $color13     #c7a9ff
set $color14     #a4daff
set $color15     #c0caf5
set $foreground  #c0caf5
set $background  #24283b
set $cursorColor #c0caf5

